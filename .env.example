DATABASE_URL="mysql://user:password@localhost:3306/roblox_tracker?timezone=Z"
BOT_TOKEN="AAAAA:AAAA"
ENCRYPTION_KEY="2x6TeHUWcqRgDShwHyaqttXyM4b2MdYe"
NODE_ENV="development"
ADMIN_USER_IDS="12345678,87654321"

# ── Polling cadence ───────────────────────────────────────────────────────────
# Base presence poll interval (ms). The worker stretches this automatically
# while Roblox is throttling us.
PRESENCE_POLL_INTERVAL_MS=30000
# Base friend-sync interval (ms).
FRIEND_SYNC_INTERVAL_MS=1200000

# ── Batching ──────────────────────────────────────────────────────────────────
# user IDs per presence request. Roblox rejects more than 50 (HTTP 400), so this
# is capped at 50. Tracked users are always placed in the earliest batches.
PRESENCE_BATCH_SIZE=50
# user IDs per POST /v1/users request (Roblox hard limit is 100).
USER_BATCH_SIZE=100
# Batches one worker cycle may spend before it yields; the rest follow next cycle.
ROBLOX_MAX_BATCHES_PER_CYCLE=8

# ── Global rate limiter ───────────────────────────────────────────────────────
# Sustained request ceiling shared by presence, friend sync, and commands.
ROBLOX_MAX_REQUESTS_PER_MINUTE=30
# Minimum spacing between consecutive request starts (ms). Off by default.
# The original rationale came from probes that were silently unauthenticated
# (expired cookie), so it measured the anonymous limiter. Raise only if
# authenticated throttling is observed; it adds latency to every command.
ROBLOX_MIN_REQUEST_GAP_MS=0
# How long a worker-cycle request waits for a free slot (ms). Must comfortably
ROBLOX_CYCLE_MAX_WAIT_MS=5000
# How long a command-driven request waits for a free slot (ms).
ROBLOX_INTERACTIVE_MAX_WAIT_MS=20000

# ── Retry / backoff ───────────────────────────────────────────────────────────
# Attempts after the first for 5xx/network failures.
ROBLOX_HTTP_MAX_RETRIES=3
# Exponential backoff base for 5xx/network failures (ms).
ROBLOX_HTTP_BASE_DELAY_MS=1000
# Attempts after the first made specifically for 429s (command calls only;
# worker cycles reschedule instead of retrying inline).
ROBLOX_HTTP_MAX_429_RETRIES=2
# Floor for the 429 backoff when Retry-After is missing or shorter (ms).
ROBLOX_RATE_LIMIT_BASE_DELAY_MS=10000
# Hard ceiling for any single retry delay (ms).
ROBLOX_HTTP_MAX_DELAY_MS=60000

# ── Cooldown / circuit breaker ────────────────────────────────────────────────
# Cooldown opened by a 429 when Retry-After is absent or shorter (ms). Never
# doubles per consecutive 429: measured penalty windows are short, and
# escalation is what pinned the bot into permanent backoff.
ROBLOX_COOLDOWN_MS=45000
# Hard ceiling for a cooldown, even when Retry-After asks for longer (ms).
ROBLOX_COOLDOWN_MAX_MS=600000
# Max poll slow-down factor while penalised.
ROBLOX_ADAPTIVE_MAX_MULTIPLIER=4

# ── Diagnostics ───────────────────────────────────────────────────────────────
# One [RBX] line per Roblox request (timestamp, endpoint, gap, status,
# Retry-After, x-ratelimit-*). Off by default: one line per request is noisy.
ROBLOX_FORENSIC_LOG=false

# ── Auth health ───────────────────────────────────────────────────────────────
# How often the stored cookie is re-validated against /v1/users/authenticated.
# An expired cookie is served as ANONYMOUS by the presence endpoint (not a 401)
# and produces unexplained 429s, so this check is the guard against a repeat.
AUTH_CHECK_INTERVAL_MS=900000
# Minimum gap between invalid-cookie alerts for the same account (hours).
AUTH_ALERT_COOLDOWN_HOURS=6